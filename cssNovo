@import url("https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");

* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  font-family: Roboto, sans-serif;
  color: rgb(6, 6, 66);
  background-color: rgb(9, 20, 80);
}

main {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 2rem 1 rem;
}

.painel {
  width: min(100%, 64rem);
  padding: clamp(1.5rem, 5vw, 2.75rem);
  background-color: rgba(255,253,249, 0.95);
  border: 1px solid rgba(255,253,249, 0.65);
  border-radius: 1.75rem;
}

.cabecalho {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}
#cidade {
  width: 100%;
  padding: 0.625rem;
  font-size: 1rem;
}

.cidade {
  width: 100%;
  padding: 0.625rem;
  cursor: pointer;
  background-color: rgb(255, 187, 0);
  border: 1px solid blue;
}

.cidade:hover {
  background-color: grey;
}

#previsao {
  margin-top: 1rem;
  background-color: azure;
}

.dia {
  padding: 0.625rem;
  border: 1px solid green;
}
